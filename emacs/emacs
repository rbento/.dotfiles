;;; init.el --- rbento's personal Emacs configuration 

;; ============================================================================
;; 1. PACKAGE SYSTEM & BOOTSTRAP
;; ============================================================================

(require 'package)
(setq package-archives
      '(("gnu"    . "https://elpa.gnu.org/packages/")
        ("nongnu" . "https://elpa.nongnu.org/nongnu/")
        ("melpa"  . "https://melpa.org/packages/")))
(package-initialize)
(unless package-archive-contents (package-refresh-contents))

(require 'use-package)
(setq use-package-always-ensure t)

(setq custom-file (locate-user-emacs-file "custom.el"))
(when (file-exists-p custom-file) (load custom-file))

(use-package exec-path-from-shell
  :config (exec-path-from-shell-initialize))

(setq native-comp-async-report-warnings-errors 'silent)

;; ============================================================================
;; 2. USER INTERFACE (UI) OPTIONS
;; ============================================================================

(setq inhibit-startup-message t)

(scroll-bar-mode -1)
(tool-bar-mode -1)
(menu-bar-mode -1)
(tooltip-mode 1)

(column-number-mode 1)
(global-display-line-numbers-mode 1)
(setq ring-bell-function 'ignore)
(load-theme 'deeper-blue t)

;; ============================================================================
;; 3. EDITOR DEFAULTS (VIM "SET" EQUIVALENTS)
;; ============================================================================

(setq-default indent-tabs-mode nil
              tab-width 4
              c-basic-offset 4
              truncate-lines t)

(setq make-backup-files nil
      auto-save-default nil
      create-lockfiles nil)

(setq select-enable-clipboard t
      case-fold-search t
      shell-file-name "/bin/bash")

(setq evil-split-window-below t
      evil-vsplit-window-right t)

(setq ff-always-in-other-window t)

(setq inhibit-compacting-font-caches t)
(recentf-mode 1)
(show-paren-mode 1)
(electric-pair-mode 1)

;; Compilation settings: open at bottom
(setq compilation-read-command nil
      compile-command "make"
      compilation-scroll-output t
      compilation-ask-about-save nil)

(add-to-list 'display-buffer-alist
             '("^\\*compilation\\*$"
               (display-buffer-reuse-window display-buffer-below-selected)
               (window-height . 0.33)))

;; ============================================================================
;; 4. EVIL MODE & VIM EMULATION PACKAGES
;; ============================================================================

(use-package evil
  :init
  (setq evil-want-keybinding nil
        evil-want-C-u-scroll t
        evil-want-C-i-jump t
        evil-undo-system 'undo-redo
        evil-search-module 'evil-search
        evil-ex-search-case 'smart
        evil-shift-width 4)
  :config
  (evil-mode 1))

(use-package evil-collection
  :after evil
  :config
  (evil-collection-init))

(use-package evil-commentary
  :after evil
  :config
  (evil-commentary-mode 1))

(use-package evil-matchit
  :after evil
  :config
  (global-evil-matchit-mode 1))

(use-package evil-goggles
  :after evil
  :config
  (evil-goggles-mode 1))

(use-package editorconfig
  :config
  (editorconfig-mode 1))

;; ============================================================================
;; 5. LEADER KEY INFRASTRUCTURE
;; ============================================================================

(use-package which-key
  :init
  (which-key-mode 1))

(use-package general
  :after evil
  :config
  (general-create-definer leader-def
    :states '(normal visual)
    :keymaps 'override
    :prefix ","))

;; ============================================================================
;; 6. COMPLETION UI & CENTRALIZED SEARCH (VERTICO / FZF ECOSYSTEM)
;; ============================================================================

(use-package savehist
  :ensure nil
  :init
  (savehist-mode 1))

(use-package vertico
  :init
  (vertico-mode 1)
  :custom
  (vertico-cycle t)
  (vertico-count 15))

(use-package vertico-posframe
  :after vertico
  :init
  (vertico-posframe-mode 1)
  :custom
  (vertico-posframe-poshandler #'posframe-poshandler-frame-center))

(use-package orderless
  :custom
  (completion-styles '(orderless basic))
  (completion-category-overrides '((file (styles partial-completion)))))

(use-package marginalia
  :init
  (marginalia-mode 1))

(use-package consult
  :custom
  ;; Exclude build artifacts, temp files, and caches cleanly from search/find
  (consult-find-args "fd --type f --hidden --follow --exclude .git --exclude tmp --exclude target --exclude bin --exclude build --exclude __pycache__ --exclude '*.o' --exclude '*.class' --exclude '*.swp' --exclude '*~' --exclude '*#'"))

(use-package corfu
  :init
  (global-corfu-mode)
  :custom
  (corfu-auto t)
  (corfu-auto-delay 0.1)
  (corfu-cycle t))

(use-package cape
  :init
  (add-to-list 'completion-at-point-functions #'cape-dabbrev)
  (add-to-list 'completion-at-point-functions #'cape-file))

;; ============================================================================
;; 7. LANGUAGE SERVER PROTOCOL (LSP) & TOOLS VIA EGLOT
;; ============================================================================

(require 'eglot)

(add-hook 'c-mode-hook #'eglot-ensure)
(add-hook 'c++-mode-hook #'eglot-ensure)
(add-hook 'c-ts-mode-hook #'eglot-ensure)
(add-hook 'c++-ts-mode-hook #'eglot-ensure)

(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs
               '((c-mode c++-mode c-ts-mode c++-ts-mode) . ("clangd" "--background-index")))
  (define-key eglot-mode-map (kbd "C-c c a") #'eglot-code-actions))

(use-package eglot-java
  :hook ((java-mode java-ts-mode) . eglot-java-mode))

(use-package consult-eglot
  :after (consult eglot))

(use-package expand-region)

;; NASM and DASM configurations for 8-column hardware tabs
(use-package nasm-mode
  :mode "\\.\\(asm\\|inc\\)\\'"
  :hook (nasm-mode . (lambda ()
                       (setq indent-tabs-mode t
                             tab-width 8
                             evil-shift-width 8))))

(add-to-list 'auto-mode-alist '("\\.dasm\\'" . asm-mode))
(add-hook 'asm-mode-hook (lambda ()
                           (setq indent-tabs-mode t
                                 tab-width 8
                                 evil-shift-width 8)))

(use-package avy
  :bind (("C-;" . avy-goto-char-timer)))

;; ============================================================================
;; 8. KEYBINDINGS & MAPPINGS
;; ============================================================================

(defun cfg/organize-imports ()
  "Organize imports (eglot), suppressing errors if unsupported (e.g. clangd)."
  (interactive)
  (ignore-errors
    (eglot-code-actions nil nil "source.organizeImports" t)))

(general-define-key
 :states '(normal visual)
 "j" #'evil-next-visual-line
 "k" #'evil-previous-visual-line
 "H" #'previous-buffer
 "L" #'next-buffer)

(leader-def
  "."  #'goto-last-change
  "b"  #'ibuffer
  "e"  #'consult-buffer
  "E"  #'consult-line
  "f"  #'consult-find
  "F"  #'project-find-file
  "C"  #'vc-print-root-log
  "i"  #'consult-ripgrep
  "d"  (general-simulate-key "yyp")
  "l"  #'eglot-format-buffer
  "L"  #'cfg/organize-imports
  "O"  #'dired-jump
  "rr" #'eglot-rename
  "j"  #'evil-ex-search-forward
  "s"  #'save-buffer
  "w"  #'evil-window-next
  "<escape>" #'delete-other-windows
  "a"  #'ff-find-other-file
  "k"  #'eldoc-doc-buffer
  "M"  #'consult-eglot-symbols
  "mm" #'evil-set-marker
  "ml" #'consult-mark
  "1"  (lambda () (interactive) (pop-to-buffer "*scratch*" '(display-buffer-below-selected (window-height . 0.33))))
  "0"  (lambda () (interactive) (pop-to-buffer "*Messages*" '(display-buffer-below-selected (window-height . 0.33)))))

(leader-def
  :states 'visual
  "v"  #'er/expand-region)

(with-eval-after-load 'eglot
  (general-define-key
   :states 'normal :keymaps 'eglot-mode-map
   "gb" #'eglot-find-implementation
   "gd" #'eglot-find-declaration
   "gf" #'xref-find-definitions
   "gp" #'xref-find-definitions-other-window
   "gr" #'xref-find-references
   "gt" #'eglot-find-typeDefinition
   "K"  #'eldoc-doc-buffer))

(global-set-key (kbd "<f1>")    #'consult-info)
(global-set-key (kbd "<f3>")    #'consult-recent-file)
(global-set-key (kbd "<f4>")    #'kill-current-buffer)
(global-set-key (kbd "<f8>")    #'flymake-goto-next-error)
(global-set-key (kbd "<S-f8>")  #'flymake-goto-prev-error)
(global-set-key (kbd "<M-f8>")  #'consult-flymake)
(global-set-key (kbd "<f9>")    #'next-error)
(global-set-key (kbd "<S-f9>")  #'previous-error)
(global-set-key (kbd "<M-f9>")  #'consult-compile-error)
(global-set-key (kbd "<f12>")   #'consult-imenu)
(global-set-key (kbd "<M-f12>") #'revert-buffer-quick)

(setq ff-search-directories
      '("." ".." "../include" "include" "../inc" "inc" "../src" "src"
        "/usr/include" "/usr/local/include"))

;; Build commands mapped to Vim parity
(defun cfg/build-clean ()
  (interactive)
  (let ((default-directory (project-root (project-current t))))
    (compile "make clean all" t)))

(defun cfg/build-run ()
  (interactive)
  (let ((default-directory (project-root (project-current t))))
    (compile "make run" t)))

(global-set-key (kbd "<f6>")   #'project-compile) ;; defaults to make
(global-set-key (kbd "<S-f6>") #'cfg/build-clean)
(global-set-key (kbd "<f7>")   #'cfg/build-run)

;; ============================================================================
;; 9. DEBUGGER (external gdb in konsole)
;; ============================================================================
(defun cfg/debug-external ()
  "Launch gdb in a separate konsole window (vim parity)."
  (interactive)
  (let* ((default-directory (project-root (project-current t)))
         (bin (string-trim (shell-command-to-string "make print-target"))))
    (start-process "gdb-external" nil
                   "konsole" "-e" "bash" "-c"
                   (format "gdb -ex 'break _start' -ex run ./%s; exec bash" bin))))
(global-set-key (kbd "<f5>") #'cfg/debug-external)

;; ============================================================================
;; 10. INITIALIZATION DIRECTORY
;; ============================================================================

(when (file-directory-p "~/Workspace") (cd "~/Workspace"))

(provide 'init)
;;; init.el ends here
