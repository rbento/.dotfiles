"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" ideavim settings
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

set hlsearch                           " highlight all search matches
set ignorecase                         " case-insensitive search
set incsearch                          " jump to matches while typing
set showmode                           " show current mode in status bar
set undolevels=0                       " undo in one step (no double-u)

set visualbell                         " no beep, flash instead
set noerrorbells                       " no error beep
set t_vb=                              " clear visual bell terminal code

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" ideavim options
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

set ideajoin                           " join lines via IDE (shift + J)
set idearefactormode=keep              " stay in normal mode during rename
set ideastatusicon=gray                " quieter status-bar icon

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" ideavim plugins
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

set NERDTree                           " file tree plugin
set surround                           " surround plugin

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" leader + ex mode
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

noremap ; :                            " quick ex mode
let mapleader=","                      " command leader

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - core (matches vimrc)
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" move into wrapped lines
nnoremap j gj
nnoremap k gk

" go to last edit location
nnoremap <leader>. g;

" duplicate current line
nnoremap <leader>d Yp

" prepare incremental search forward
nnoremap <leader>j :/

" save / overwrite
nnoremap <leader>s :w!<CR>

" cycle windows
nnoremap <leader>w <C-w>w

" list buffers
nnoremap <leader>b :ls<CR>

" show marks                                       [vimrc <leader>ml]
nnoremap <leader>ml :marks<CR>

" delete all marks                                 [vimrc <leader>mr]
nnoremap <leader>mr :delmarks!<CR>

" delete current buffer                            [vimrc <F4>]
nnoremap <F4> :bd<CR>

" switch buffers
nnoremap <silent> H :bp<CR>
nnoremap <silent> L :bn<CR>

" close all other splits, keep current             [vimrc :only]
nmap <silent> <leader><Space> <Action>(HideActiveWindow)

" format whole file + organize imports             [vimrc <leader>l]
nmap <leader>l <Action>(ReformatCode)<Action>(OptimizeImports)

" next bookmark
nmap <F2>   <Action>(GotoNextBookmark)

" toggle bookmark
nmap <S-F2> <Action>(ToggleBookmark)

" show bookmarks
nmap <A-F2> <Action>(ShowBookmarks)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - search & navigation
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" open file
nmap <leader>O <Action>(OpenFile)

" file explorer, reveal current file               [vimrc :Ex]
nmap <leader>E :NERDTreeFind<CR>

" find in files (regex)                            [vimrc <leader>F :RG]
nmap <leader>F <Action>(FindInPath)

" replace in files
nmap <leader>R <Action>(ReplaceInPath)

" file search (project-wide)                       [vimrc <leader>f :Files]
nmap <leader>f <Action>(GotoFile)

" class search (project-wide)
nmap <leader>t <Action>(GotoClass)

" text search (project-wide)                       [vimrc <leader>i :Rg]
nmap <leader>i <Action>(TextSearchAction)

" symbol search (project-wide)                     [vimrc <leader>m]
nmap <leader>m <Action>(GotoSymbol)

" go to line:column                                [vimrc <number>G]
nmap <leader>g <Action>(GotoLine)

" open buffers / switcher                          [vimrc <leader>e :Buffers]
nmap <leader>e <Action>(Switcher)

" recently opened files                            [vimrc <leader>h :History]
nmap <leader>h <Action>(RecentFiles)
nmap <F3> <Action>(RecentFiles)

" recently changed files
nmap <leader>H <Action>(RecentChangedFiles)
nmap <S-F3> <Action>(RecentChangedFiles)

" show commits                                     [vimrc <leader>0 :Commits]
nmap <leader>0 <Action>(Vcs.Show.Log)

" show console                                     [vimrc <leader>1 :messages]
nmap <leader>1 <Action>(Vcs.Show.Console)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - lsp -> ide actions
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" goto implementation                              [vimrc gb]
nmap gb <Action>(GotoImplementation)

" goto super method                                [vimrc gu]
nmap gu <Action>(GotoSuperMethod)

" goto declaration                                 [vimrc gd]
nmap gd <Action>(GotoDeclaration)

" goto definition                                  [vimrc gf]
nmap gf <Action>(GotoDefinition)

" goto type definition                             [vimrc gt]
nmap gt <Action>(GotoTypeDeclaration)

" find references / usages                         [vimrc gr]
nmap gr <Action>(FindUsages)

" peek / quick definition popup                    [vimrc gp]
nmap gp <Action>(QuickImplementations)

" hover / quick doc                                [vimrc K]
nmap K <Action>(QuickJavaDoc)

" signature / parameter info                       [vimrc <leader>k]
nmap <leader>k <Action>(ParameterInfo)

" file structure / document symbols                [vimrc <F12>]
nmap <F12> <Action>(FileStructurePopup)

" call hierarchy                                   [vimrc <leader>ic/oc]
nmap <leader>ic <Action>(CallHierarchy)
nmap <leader>oc <Action>(CallHierarchy)

" rename                                           [vimrc <leader>rr]
nmap <leader>rr <Action>(RenameElement)

" expand selection (visual)                        [vimrc <leader>v]
vmap <leader>v <Action>(EditorSelectWord)

" switch header/source (CLion)                     [vimrc <leader>a]
" nmap <leader>a <Action>(CIDR.Lang.SwitchHeaderSource)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - build / run / debug (ide-native)
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" build
nmap <F6> <Action>(CompileDirty)

" clean / build
nmap <S-F6> <Action>(CompileProject)

" run
nmap <F7> <Action>(Run)

" debug
nmap <F5> <Action>(Debug)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - diagnostics
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" next error                                       [vimrc <F8>]
nmap <F8> <Action>(GotoNextError)

" previous error                                   [vimrc <S-F8>]
nmap <S-F8> <Action>(GotoPreviousError)

" toggle breakpoint
nmap <A-F8> <Action>(ToggleLineBreakpoint)
