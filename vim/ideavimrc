"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" ideavim settings
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" highlight as we type
set hlsearch

" ignore case when searching
set ignorecase

" search incrementally
set incsearch

" show current mode in status bar
set showmode

" prevents having to type u twice to undo
set undolevels=0

" disable bell sound
set visualbell
set noerrorbells
set t_vb=

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" ideavim options
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" enable join lines with shift + J
set ideajoin

" stay in normal mode during rename refactors
set idearefactormode=keep

" quieter status-bar icon
set ideastatusicon=gray

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" ideavim plugins
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" enable NERDTree plugin
set NERDTree

" enable surround plugin
set surround

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" leader + ex mode
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" quick ex mode
noremap ; :

" configure command leader 
let mapleader=","

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - core (native vim, matches vimrc)
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" move into wrapped lines and keep the cursor centered (ideavim-only zz)
nnoremap j gj
nnoremap k gk

" clear the search buffer when hitting return
nnoremap <space><cr> :nohlsearch<cr>

" clear search highlight
nnoremap <leader>h :nohl<CR>

" go to last edit location
nnoremap <leader>. g;

" go to last edit location in insert mode
nnoremap <leader>; gi

" duplicate current line
nnoremap <leader>d Yp

" prepare for search/replace on the whole file
nnoremap <leader>rf :%s/

" prepare for search/replace on the current line
nnoremap <leader>rl V:s/

" prepare incremental search forward
nnoremap <leader>j :/

" save / overwrite
nnoremap <leader>s :w!<CR>

" cycle windows
nnoremap <leader>w <C-w>w

" list buffers
nnoremap <leader>b :ls<CR>

" marks
nnoremap <leader>M :marks<CR>
nnoremap <leader>Md :delmarks!<CR>   

" delete current buffer
nnoremap <leader>q :bd<CR>
nnoremap <F4> :bd<CR>

" switch buffers
nnoremap <silent> H :bp<CR>
nnoremap <silent> L :bn<CR>

" close all other splits, keep current [vimrc :only]
nmap <silent> <leader><space> <Action>(HideActiveWindow)

" format whole file + organize imports 
nmap <leader>L <Action>(ReformatCode)<Action>(OptimizeImports)

" bookmarks
nmap <F2>   <Action>(GotoNextBookmark)
nmap <S-F2> <Action>(ToggleBookmark)
nmap <A-F2> <Action>(ShowBookmarks)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - search & navigation 
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" open file 
nmap <leader>O <Action>(OpenFile)

" file explorer, reveal current file               [vimrc :Ex]
nmap <leader>E :NERDTreeFind<CR>

" find in files                                    [vimrc :Rg]
nmap <leader>F <Action>(FindInPath)

" replace in files
nmap <leader>R <Action>(ReplaceInPath)

" file search (project-wide)                       [vimrc :Files]
nmap <leader>f <Action>(GotoFile)

" class search (project-wide)                      [vimrc :GFiles]
nmap <leader>t <Action>(GotoClass)

" grep (project-wide)                              [vimrc :Rg]
nmap <leader>i <Action>(TextSearchAction)

" symbol search (project-wide)                     [vimrc <leader>m]
nmap <leader>m <Action>(GotoSymbol)

" go to line:colunm                                [vimrc <number>G]
nmap <leader>G <Action>(GotoLine)

" open buffers / switcher                          [vimrc :Buffers]
nmap <leader>e <Action>(Switcher)

" show commits                                     [vimrc :Commits]
nmap <leader>C <Action>(Vcs.Show.Log)

" recently opened files                            [vimrc :History]
nmap <F6> <Action>(RecentFiles)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - (LSP -> IDE actions)
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" goto definition                                  [vimrc gf]
nmap gf <Action>(GotoDeclaration)

" goto declaration                                 [vimrc gd]
nmap gd <Action>(GotoDeclaration)

" goto implementation                              [vimrc gb]
nmap gb <Action>(GotoImplementation)
nmap gu <Action>(GotoSuperMethod)

" goto type definition                             [vimrc gt]
nmap gt <Action>(GotoTypeDeclaration)

" find references / usages                         [vimrc gr]
nmap gr <Action>(FindUsages)

" peek / quick definition popup                    [vimrc gp]
nmap gp <Action>(QuickImplementations)

" hover / quick doc (works for C/C++ too)          [vimrc K]
nmap K <Action>(QuickJavaDoc)

" signature / parameter info                       [vimrc <leader>k]
nmap <leader>k <Action>(ParameterInfo)

" file structure / document symbols                [vimrc <F12>]
nmap <F12> <Action>(FileStructurePopup)

" call hierarchy                                   [vimrc <leader>ci/co]
nmap <leader>ci <Action>(CallHierarchy)
nmap <leader>co <Action>(CallHierarchy)

" rename                                           [vimrc <leader>rr]
nmap <leader>rr <Action>(RenameElement)

" format                                           [vimrc <leader>F]
nmap <leader>l <Action>(ReformatCode)

" expand selection (visual)                        [vimrc <leader>v]
vmap <leader>v <Action>(EditorSelectWord)

" switch header/source (CLion)
" nmap <leader>a <Action>(CIDR.Lang.SwitchHeaderSource)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - build / run 
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" build                                            [vimrc <F7> :make]
nmap <F7> <Action>(CompileDirty)

" clean / build                                    [vimrc <A-F7>]
nmap <S-F7> <Action>(CompileProject)

" start debug session                              [vimrc <F5>]
nmap <F5> <Action>(Run)

" start debug session                              [vimrc <S-F5>]
nmap <S-F5> <Action>(Debug)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - diagnostics
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" next error                                       [vimrc <F8>]
nmap <F8> <Action>(GotoNextError)

" previous error                                   [vimrc <S-F8>]
nmap <S-F8> <Action>(GotoPreviousError)

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" key mappings - debugging
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" toggle breakpoint                                [vimrc :Break]
nmap <A-F8>  <Action>(ToggleLineBreakpoint)
