"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" custom automation
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

augroup CustomAutomation
    au!

    " NASM x86-64
    autocmd BufRead,BufNewFile *.asm set filetype=nasm
    autocmd FileType nasm setlocal noexpandtab
    autocmd FileType nasm setlocal commentstring=;\ %s
    autocmd FileType nasm setlocal makeprg=make

    " C/C++
    autocmd FileType c,cpp setlocal commentstring=//\ %s
    autocmd FileType c,cpp setlocal errorformat=%f:%l:%c:\ %t%*[^:]:\ %m,%f:%l:\ %t%*[^:]:\ %m,%-G%.%#
    autocmd FileType c,cpp setlocal makeprg=make

    " Java
    autocmd FileType java setlocal commentstring=//\ %s
    autocmd FileType java setlocal errorformat=[ERROR]\ %f:[%l\,%c]\ %m,%-G%.%#
    autocmd FileType java setlocal makeprg=mvn\ -q\ compile

    " do not list cache or build artifacts in buffers
    autocmd BufReadPost,BufNewFile */.cache/*,*.o,*.obj,*.a,*.so,*.class,*.d,*#,*~ setlocal nobuflisted

    " quit hidden buffers - keep non-file buffers out of :Buffers
    autocmd TerminalOpen * if &buftype ==# 'terminal' | setlocal nobuflisted bufhidden=wipe | endif
    autocmd FileType qf setlocal nobuflisted

    " LSP: register servers, wire buffer-local maps on attach
    autocmd User LspSetup call LspAddServer(s:lspServers)
    autocmd User LspAttached call s:OnLspBufferEnabled()

    " GUI: silence the bell
    au GUIEnter * set visualbell t_vb=

augroup END

