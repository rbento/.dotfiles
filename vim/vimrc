"" custom functions
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

function! SetMarkAtCurrentLine()
    let l:letters = 'abcdefghijklmnopqrstuvwxyz'
    let l:current_line = line('.')
    " check if the current line already has a mark
    for l:letter in split(l:letters, '\zs')
        if getpos("'" . l:letter)[1] == l:current_line
            echo "Mark " . l:letter . " already set at line " . l:current_line 
            return
        endif
    endfor
    " find an unused mark
    for l:letter in split(l:letters, '\zs')
        if getpos("'" . l:letter)[1] == 0  " mark is unused if line == 0
            execute "mark " . l:letter
            echo "Mark " . l:letter . " set at line " . l:current_line 
            return
        endif
    endfor
    echo "No unused marks available"
endfunction

function! s:OnLspBufferEnabled() abort
    setlocal tagfunc=lsp#lsp#TagFunc
    " navigation
    nnoremap <buffer> <silent> gb :LspGotoImpl<CR>
    nnoremap <buffer> <silent> gd :LspGotoDeclaration<CR>
    nnoremap <buffer> <silent> gf :LspGotoDefinition<CR>
    nnoremap <buffer> <silent> gh :LspSubTypeHierarchy<CR>
    nnoremap <buffer> <silent> gp :LspPeekDefinition<CR>
    nnoremap <buffer> <silent> gr :LspShowReferences<CR>
    nnoremap <buffer> <silent> gt :LspGotoTypeDef<CR>
    nnoremap <buffer> <silent> gu :LspSuperTypeHierarchy<CR>
    " info
    nnoremap <buffer> <silent> K  :LspHover<CR>
    nnoremap <buffer> <silent> <leader>k :LspShowSignature<CR>
    " symbols / structure
    nnoremap <buffer> <silent> <F12> :LspDocumentSymbol<CR>
    nnoremap <buffer> <silent> <leader>m :LspSymbolSearch<CR>
    nnoremap <buffer> <silent> <leader>ic :LspIncomingCalls<CR>
    nnoremap <buffer> <silent> <leader>oc :LspOutgoingCalls<CR>
    " refactor / edit
    nnoremap <buffer> <silent> <leader>rr :LspRename<CR>
    nnoremap <buffer> <silent> <leader>l :LspFormat<CR>:LspOrganizeImports<CR>
    nnoremap <buffer> <silent> <leader>ca :LspCodeAction<CR>
    nnoremap <buffer> <silent> <leader>cf :LspFixAll<CR>
    xnoremap <buffer> <silent> <leader>v :LspSelectionExpand<CR>
    xnoremap <buffer> <silent> <leader>V :LspSelectionShrink<CR>
endfunction

" ---- termdebug (gdb) key mappings ----
" F5 starts a session (build debug + launch on this project's binary).
" All other debug keys are installed ONLY while a session is active and
" reverted to their normal editing meaning when the session ends.

" F5: build debug binary, then launch termdebug on this project's target
function! s:DebugStart() abort
    let g:debug_return_win = win_getid()
    silent make debug
    execute 'Termdebug ./' . trim(system('make print-target'))
endfunction

function! s:OnDebugLayout() abort
    " focus back on the code, same line
    if exists('g:debug_return_win')
        call win_gotoid(g:debug_return_win)
    endif
endfunction

" installed when a debug session starts
function! s:OnDebugMapsOn() abort
    let g:in_debug = 1
    nnoremap <silent> <F5>    :Run<CR>
    nnoremap <silent> <F8>    :Break<CR>
    nnoremap <silent> <S-F8>  :Clear<CR>
    nnoremap <silent> <F9>    :Over<CR>
    nnoremap <silent> <F10>   :Step<CR>
    nnoremap <silent> <S-F10> :Finish<CR>
    nnoremap <silent> <F11>   :Continue<CR>
    nnoremap <silent> <S-F11> :call TermDebugSendCommand('quit')<CR>
    nnoremap <silent> <S-F12> :Asm<CR>
    call s:OnDebugLayout()
endfunction

" restored when the debug session ends
function! s:OnDebugMapsOff() abort
    let g:in_debug = 0
    " start debug session
    nnoremap <silent> <F5>   :call <SID>DebugStart()<CR>
    nnoremap <silent> <F8>   :LspDiag next<CR>
    nnoremap <silent> <S-F8> :LspDiag prev<CR>
    nnoremap <silent> <F9>   :cn<CR>
    nnoremap <silent> <S-F9> :cp<CR>
    silent! nunmap <F10>
    silent! nunmap <S-F10>
    silent! nunmap <F11>
    silent! nunmap <S-F11>
    silent! nunmap <S-F12>
endfunction

