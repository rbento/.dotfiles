"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"" vim options
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

set nocompatible                           " use vim defaults, not vi
set autoindent                             " copy indent from current line on new line
set autoread                               " reload files changed outside vim
set backspace=indent,eol,start             " let backspace cross indent, eol, insert start
set cindent                                " c-style automatic indenting
set clipboard=unnamedplus                  " yank/paste through the system clipboard
set cmdheight=2                            " command line is two rows tall
set encoding=utf-8                         " internal character encoding
set expandtab                              " insert spaces instead of tabs
set gp=git\ grep\ -n                       " :grep uses git grep with line numbers
set hidden                                 " keep modified buffers when switching away
set hlsearch                               " highlight all search matches
set ignorecase                             " case-insensitive search
set incsearch                              " jump to matches while typing
set mouse=a                                " enable mouse in all modes
set noerrorbells visualbell t_vb=          " no beep, no flash
set nobackup                               " no backup files
set noswapfile                             " no swap files
set noundofile                             " no persistent undo files
set nowrap                                 " don't wrap long lines
set number                                 " show line numbers
set ruler                                  " show cursor position
set shell=/bin/bash                        " shell used for :! and :terminal
"set shell=cmd.exe                         " (windows alternative)
set shiftwidth=4                           " indent width for >> and autoindent
set showcmd                                " show partial command in the last line
set smartcase                              " case-sensitive if search has uppercase
set smarttab                               " tab respects shiftwidth at line start
set softtabstop=4                          " tab/backspace feel like 4 spaces
set splitbelow                             " horizontal splits open below
set splitright                             " vertical splits open right
set t_vb=                                  " clear visual bell terminal code
set tabstop=4                              " a tab renders as 4 columns
set tags=./tags,tags                       " tag files: file dir first, then cwd
set timeout timeoutlen=500 ttimeoutlen=10  " mapping / key-code timeouts (ms)
set wildmenu                               " enhanced command-line completion menu
set wildmode=list:longest,full             " complete longest match, then cycle full

" ignore these in completion/globs
set wildignore+=*/tmp/*,*/target/*,*/bin/*,*/build/*,*/__pycache__/*,*.tar,*.gz,*.7z,*.iso,*.so,*.swp,*.zip,*.class,*#,*~,*.o  

